{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "freshcontext-mcp",
  // E-2: the deployed entry point is the wrapper, which serves the public key document
  // and the V4 verify branch and delegates everything else to worker.ts.
  "main": "src/worker-e2.ts",
  // Bumped 2026-09-10 from 2024-09-23, which was two years stale.
  //
  // 2025-10-11 rather than something nearer today because that is the newest date the
  // test runtime can actually execute: @cloudflare/vitest-pool-workers pins its own
  // nested workerd 1.20251011.0, older than the 1.20260609.1 wrangler bundles. Set a
  // date above it and miniflare silently falls back, so the suite would be proving
  // things about a runtime production does not run.
  //
  // vitest.config.mts reads this value rather than restating it AND refuses to start if
  // it exceeds the pool's workerd, so neither half of that can drift again. To go newer,
  // upgrade @cloudflare/vitest-pool-workers first — the tests are the constraint, and
  // they should be.
  "compatibility_date": "2025-10-11",
  "compatibility_flags": ["nodejs_compat_v2"],
  // PUBLIC Ed25519 verification key, published deliberately — see docs/VERIFYING.md.
  // Committed rather than set in the dashboard because `wrangler deploy` deletes vars
  // absent from this file. Written by scripts/write-public-key-vars.mjs during the key
  // ceremony; key_id is derived from the key itself, so editing either by hand breaks
  // the pair. The PRIVATE key is a Worker secret and never appears in this repository.
  "vars": {
    "FC_ED25519_KEY_ID": "fc-2026-09-ceced1ab",
    "FC_ED25519_PUBLIC_KEY_B64": "MCowBQYDK2VwAyEAD13q6UUVb2iTZPH9PyRHHBmwoHMjvwb2Nnb9KRkq+r0="
  },
  "browser": {
    "binding": "BROWSER"
  },
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freshcontext-db",
      "database_id": "d9898d65-f67e-4dcb-abdc-7f7b53f2d444",
      "migrations_dir": "migrations"
    }
  ],
  // RATE_LIMITER (KV 7b74255ddbee42a99feea5898a11842b) was removed 2026-09-03 with RT-5.
  // Nothing reads it now that /mcp uses the atomic MCP_RATE_LIMITER binding. The namespace
  // itself still exists in the Cloudflare account and is not deleted here — only unbound.
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "2bfd2b8f371345d493af520644364c6c"
    }
  ],
  // Native (atomic) Rate Limiting binding for the public /v1/verify endpoint (F-3).
  // 100 requests per 60s per IP. namespace_id is a self-assigned identifier (no account
  // provisioning). Enforced only on the deployed network, not in local dev.
  "ratelimits": [
    {
      "name": "VERIFY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    },
    // RT-5: /mcp reaches the extract_* tools, which launch a headless browser per call.
    // It previously used a KV get-then-put counter, which is neither atomic nor strongly
    // consistent, so a concurrent burst all read the same count and each wrote count+1 —
    // the cap was trivially exceeded. The else-branch also re-put on every hit, refreshing
    // the TTL so a steady stream never rolled the window. Same limit/period as before.
    // Measured 2026-09-03 against production: with { limit: 60, period: 60 } a single IP
    // pushed 100 requests in 4.1s with ZERO 429s, and ~140 in-window before the limiter
    // began rejecting. Cloudflare's binding is atomic and per-colo but its accounting is
    // best-effort, so a 60-second window barely constrains a short burst — which is exactly
    // the shape of the abuse this protects against on the browser-launching path.
    // 10 requests / 10s keeps the same 60/min sustained rate while bounding a burst to ~10.
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 10 }
    }
  ],
  "assets": {
    "directory": "../demo",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
